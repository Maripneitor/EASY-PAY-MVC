    "@react-native-community/netinfo": "11.4.1",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-navigation/native": "^7.0.14",
    "@tanstack/react-query": "^5.0.0",
    "@types/react": "~19.1.10",
    "ajv": "^8.18.0",
    "ajv-keywords": "^5.1.0",
    "axios": "^1.6.0",
