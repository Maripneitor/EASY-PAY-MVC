{
  "name": "mobile-app",
  "main": "index.js",
  "version": "1.0.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "commonjs",
  "scripts": {
    "start": "cross-env EXPO_ROUTER_APP_ROOT=app EXPO_METRO_CONFIG=./metro.config.cjs expo start",
    "expo-go": "cross-env EXPO_ROUTER_APP_ROOT=app EXPO_METRO_CONFIG=./metro.config.cjs expo start --lan",
    "web": "cross-env EXPO_ROUTER_APP_ROOT=app EXPO_METRO_CONFIG=./metro.config.cjs expo start --web",
    "build:web": "cross-env EXPO_ROUTER_APP_ROOT=app EXPO_METRO_CONFIG=./metro.config.cjs npx expo export -p web",
    "eas-build-pre-build": "echo 'org.gradle.jvmargs=-Xmx8g -XX:MaxMetaspaceSize=2g' >> android/gradle.properties"
  },
  "dependencies": {
    "@easy-pay/domain": "*",
    "@easy-pay/ui": "*",
    "@expo/config-plugins": "~54.0.0",
    "@expo/metro-runtime": "~6.1.2",
